---
// Fonts are bundled with the site (not loaded from Google Fonts), so they work in every browser.
import '@fontsource-variable/orbitron';
import '@fontsource-variable/roboto';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Remote Sensing of Marine Systems - Academic Research Lab' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - Marine Remote Sensing Lab</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
  
  html {
    scroll-behavior: smooth;
  }
  
  /* Standard font declarations (font families are defined in global.css) */
  body {
    font-family: var(--font-body);
  }

  h1, h2, h3, h4, h5, h6,
  .heading-hero, .heading-section, .heading-subsection,
  .heading-card, .heading-small, .nav-brand {
    font-family: var(--font-heading);
  }
</style>