# Regenerate the publication word clouds when their inputs are part of this commit.
if git diff --cached --name-only | grep -qE '^(src/pages/(publications|team)/|scripts/generate-word-cloud\.mjs$)'; then
  echo "Publications/team changed - regenerating word clouds..."
  npm run --silent word-cloud || exit 1
  git add public/word-cloud.html
fi
